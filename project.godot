; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wild Tiles"
config/description="Tile-match puzzle: furnish your life"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

ThemeManager="*res://scripts/ThemeManager.gd"
GameManager="*res://scripts/GameManager.gd"
LevelManager="*res://scripts/LevelManager.gd"
CollectionManager="*res://scripts/CollectionManager.gd"
SaveSystem="*res://scripts/SaveSystem.gd"
HintSystem="*res://scripts/HintSystem.gd"

[display]

window/stretch/mode="canvas_items"
window/handheld/orientation="portrait"
window/size/width=720
window/size/height=1280
window/size/test_width=540
window/size/test_height=960

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
